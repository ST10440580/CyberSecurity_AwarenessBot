<Window x:Class="CyberSecurity_AwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurity_AwarenessBot"
        mc:Ignorable="d"
        Title="CyberSecurity Bot" Height="400" Width="800">
    <!-- Button styler for buttons -->
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                BorderThickness="0"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="DarkSlateGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/images/background.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        
        
        <!-- WELCOME TO THE CHATBOT PANEL -->
        <StackPanel x:Name="WelcomePanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="White"
                    Margin="10"
                    Width="500"
                    Visibility="Visible">

            <TextBlock Text="WELCOME TO THE CHATBOT"
                       Foreground="Black"
                       FontSize="24"
                       FontWeight="ExtraBold"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>
            <TextBlock Text="Cybersecurity Assistant"
                       Foreground="Black"
                       FontSize="14"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Please enter your first name to get started"
                       Foreground="Black"
                       FontSize="12"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
            <TextBox x:Name="userNameBox"
                     Width="300"
                     Height="35"
                     FontSize="16"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,20"/>
            <Button Content="Continue"
                    Width="150"
                    Height="50"
                    Background="LightBlue"
                    Foreground="Black"
                    FontWeight="Bold"
                    FontSize="14"
                     Style="{StaticResource RoundedButtonStyle}"
                    Click="Continue_Click"
                    
                    HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Chat bot panel -->
        <Grid x:Name="MainChatPanel"
              Visibility="Collapsed"
              Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu/side bar panel -->
            <StackPanel Grid.Column="0"
                        Background="#FFEEEEEE"
                        Margin="5">
                <TextBlock Text="MENU"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Background="black"
                           Margin="0,0,0,10"/>
                <Button Content="Chat"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="MenuChat_Click"
                        Margin="0,50,0,0"
                        Background="LightBlue"
                        Padding="20,20"
                          Height="100"
                        Foreground="Black"/>
                <Button Content="Tasks" 
                         Style="{StaticResource RoundedButtonStyle}"
                        Click="MenuTasks_Click" 
                        Margin="0,60,0,0"
                       Background="LightBlue"
                        Padding="20,20"
                          Height="100"
                        Foreground="Black"/>
                <Button Content="Quiz" 
                         Style="{StaticResource RoundedButtonStyle}"
                        Click="MenuQuiz_Click"
                        Margin="0,70,0,0"
                         Background="LightBlue"
                        Padding="20,20"
                          Height="100"
                        Foreground="Black"/>
                <Button Content="Activity Log" 
                         Style="{StaticResource RoundedButtonStyle}"
                        Click="MenuActivityLog_Click"
                        Margin="0,80,0,0"
                        Background="LightBlue"
                        Padding="20,20"
                        Height="100"
                        Foreground="Black"/>
            </StackPanel>

            <!-- Chatbot gird handler-->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title of chat bot(Cyber Security Awareness Bot-->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Cyber Security Awareness Bot"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Image Source="images/Cyber.jpg"
                           Height="50"
                           Width="50"
                           Stretch="Uniform"/>
                </StackPanel>

                <!-- Chatlist box -->
                <ListBox x:Name="ChatList"
                         Grid.Row="1"
                         Margin="5"/>

                <!-- Input handler -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <TextBox x:Name="UserInput"
                             Width="600"
                             Height="30"
                             Margin="0,0,10,0"/>
                    <Button x:Name="SendButton"
                            Width="150"
                            Height="50"
                            Background="LightBlue"
                            Foreground="Black"
                            
                            Content="Send"
                             Style="{StaticResource RoundedButtonStyle}"
                            Click="SendButton_Click"/>
                </StackPanel>

                <!-- Task and Quiz Panel handler -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <!-- Task panel -->
                    <StackPanel x:Name="TaskPanel"
                                Visibility="Collapsed"
                                Background="White">
                        <Image Source="/images/taskpic.jpg"
                               Margin="0,10"
                               Height="100"
                               Width="200"/>
                        <TextBlock Text="Task Title:" 
                                   Margin="5,5,5,0"/>
                        <TextBox x:Name="TaskTitleBox"
                                 Margin="5"/>
                        <TextBlock Text="Description:"
                                   Margin="5,5,5,0"/>
                        <TextBox x:Name="TaskDescBox"
                                 Margin="5"/>
                        <TextBlock Text="Reminder Date:" 
                                   Margin="5,5,5,0"/>
                        <DatePicker x:Name="TaskReminderDate" 
                                    Margin="5"/>
                        <Button Content="Add Task" 
                                Click="AddTask_Click" 
                                Margin="5"
                                Padding="10,5"
                                Background="Black"
                                Foreground="White"/>
                        <ListBox x:Name="TaskListBox" 
                                 Height="100"
                                 Margin="5"
                                 
                                 />
                        <Button Content="Mark as Completed"
                                Background="Black"
                                Foreground="White"
                                Click="CompleteTask_Click" 
                                Margin="5"/>
                        <Button Content="Delete Task"
                                Background="Black"
                                 Foreground="White"
                                Click="DeleteTask_Click"
                                Margin="5"/>
                    </StackPanel>

                    <!-- Quiz panel -->
                    <StackPanel x:Name="QuizPanel"
                                Visibility="Collapsed"
                                Background="White">
                        <TextBlock x:Name="QuizQuestionText" 
                                   FontWeight="Bold" 
                                   Margin="5"/>
                        <ListBox x:Name="QuizAnswersList"
                                 SelectionMode="Single"
                                 Margin="5"
                                 Height="100"/>
                        <Button Content="Submit Answer"
                                Background="Black"
                                Foreground="White"
                                Click="SubmitQuizAnswer_Click"
                                Margin="5"/>
                    </StackPanel>
                </Grid>

                <!-- Activity Log -->
                <ListBox x:Name="ActivityLogList"
                         Grid.Row="4"
                         Height="100"
                         Margin="0,10,0,0"
                         Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>